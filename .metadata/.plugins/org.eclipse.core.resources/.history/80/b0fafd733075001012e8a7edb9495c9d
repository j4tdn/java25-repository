package datastructure;

public class Ex05SwapTest {
	public static void main(String[] args) {
		
		int a1 = 5;
		int a2 = 7;
		
		System.out.println("a1: " + a1);
		System.out.println("a2: " + a2);
		
		int temp = a1; //temp = 5
		a1 = a2;// a1 = 7
		a2 = temp; // a2 = 5
		
		System.out.println("--- After Swap---");
		
		System.out.println("a1: " + a1);
		System.out.println("a2: " + a2);
	}

}
