package lesson02_TonNuNhi;

import java.util.Scanner;

public class Ex06 {

	public static void main(String[] args) {

		Scanner ip = new Scanner(System.in);

		int a = readInRange(ip, "a", 0, 20);
		int b = readInRange(ip, "b", 0, 20);
		int c = readInRange(ip, "c", 0, 20);

		int max = a;
		if (b > max) {
			max = b;
		}
		if (c > max) {
			max = c;
		}

		int min = a;
		if (b < min) {
			min = b;
		}
		if (c < min) {
			min = c;
		}

		System.out.println("Số lớn nhất là " + max);
		System.out.println("Số nhỏ nhất là " + min);

		ip.close();
	}

	private static int readInRange(Scanner ip, String name, int minInc, int maxEx) {
		String text;
		int count = 0;
		int value = 0;
		boolean ok = false;

		do {
			System.out.print("Nhập " + name + " trong [" + minInc + ", " + maxEx + "): ");
			text = ip.nextLine();

			if (isValidText(text)) {
				value = Integer.parseInt(text);
				if (value >= minInc && value < maxEx) {
					ok = true;
					break;
				}
			}

			System.out.println("Chưa phải là số hợp lệ \n");

			count = count + 1;
			if (count == 5) {
				System.out.println("Đã quá số lần nhập → mặc định 0");
				break;
			}
		} while (true);

		return value;
	}

	private static boolean isValidText(String text) {
		if (text == null)
			return false;
		if (text.length() == 0)
			return false;
		for (int i = 0; i < text.length(); i++) {
			if (!Character.isDigit(text.charAt(i))) {
				return false;
			}
		}
		return true;
	}
}
