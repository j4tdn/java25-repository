package video_array;

public class Ex01ArrayOperation {
	
	public static void main(String[] args) {
		
		int[] numbers = new int[6];
		
		numbers[3] = 25;

		// System.out.println("Index 3:" + numbers[3] );
		// for index
		for (int i = 0; i < numbers.length; i++) {
			System.out.println("value at index " + i + ":" + numbers[i]);

		}

		System.out.println("\n==============\n");

		// for each
		for (int number : numbers) {
			System.out.println("number: " + number);
		}

		System.out.println("\n==============\n");
		String[] sequences = { "hello", "hi", "wellcome" };
		System.out.println(sequences.length);

		for (String sequence : sequences) {
			System.out.println("sequences: " + sequence);
		}

	}

}