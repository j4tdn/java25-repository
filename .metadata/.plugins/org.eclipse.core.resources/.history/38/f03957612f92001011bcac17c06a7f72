package lesson02_TonNuNhi;

import java.util.Scanner;

public class IsMultipleOfTwo {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		Integer n = readPositiveInt(sc, 5);
		if (n == null) {
			System.out.println("Nhập hợp lệ tối đa 5 lần");
			return;
		}
		boolean result = (n % 2 == 0);
		System.out.println(result);

	}

	private static Integer readPositiveInt(Scanner sc, int attempts) {
		for (int i = 0; i < attempts; i++) {
			System.out.print("Enter a positive integer N: ");
			String s = sc.nextLine().trim();
			try {
				int val = Integer.parseInt(s);
				if (val > 0)
					return val;
				System.out.println("Error: N must be > 0.");
			} catch (NumberFormatException e) {
				System.out.println("Error: not a number.");
			}
		}
		return null;
	}
}