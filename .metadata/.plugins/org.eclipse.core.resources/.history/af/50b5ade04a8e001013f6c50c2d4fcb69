package view;

public class Ex07OperatorDemo {
	
	public static void main(String[] args) {
		
		int i = 2;
		if(++i > 2 && i++ > 2) {
			i++;
		}
		
		if(i++ > 4 || ++i > 5) {
			System.out.println(i);// line 13
		}
		
		if(i++ < 4 || ++i > 5) {
			System.out.println(i);// line 17
		}
	}
	

}
