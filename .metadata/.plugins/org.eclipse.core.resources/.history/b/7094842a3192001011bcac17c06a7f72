package lesson02_TonNuNhi;

import java.util.Scanner;


public class IsMultipleOfTwo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = readPositiveInt(sc, 5);

        if (n > 0) {
            boolean result = (n % 2 == 0);
            System.out.println(result);
        } else {
            System.out.println("Nhập sai quá 5 lần");
        }
        sc.close();
    }

    private static int readPositiveInt(Scanner sc, int attempts) {
        for (int i = 0; i < attempts; i++) {
            System.out.print("Nhập số nguyên dương N: ");
            String text = sc.nextLine().trim();
            if (isPositiveInteger(text)) return Integer.parseInt(text);
            System.out.println("Không hợp lệ, nhập lại");
        }
        return 0;
    }

    private static boolean isPositiveInteger(String text) {
        if (text == null || text.isEmpty()) return false;
        for (int i = 0; i < text.length(); i++) if (!Character.isDigit(text.charAt(i))) return false;
        return Integer.parseInt(text) > 0;
    }
}
